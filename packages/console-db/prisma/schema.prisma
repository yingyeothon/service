generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model api_tokens {
  id           String  @id @db.VarChar(64)
  member_id    String  @db.VarChar(64)
  token_hash   String  @unique(map: "api_tokens_hash") @db.Char(64)
  name         String  @db.VarChar(255)
  created_at   BigInt
  last_used_at BigInt?
  revoked_at   BigInt?
  members      members @relation(fields: [member_id], references: [id], onUpdate: Restrict, map: "api_tokens_member")

  @@index([member_id], map: "api_tokens_member")
}

model asset_bundles {
  id                    String                  @id @db.VarChar(64)
  name                  String                  @db.VarChar(255)
  description           String?                 @db.MediumText
  owner_id              String?                 @db.VarChar(64)
  created_at            BigInt
  updated_at            BigInt
  team_id               String                  @db.VarChar(64)
  project_id            String                  @db.VarChar(64)
  members               members?                @relation(fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "asset_bundles_owner")
  teams                 teams                   @relation(fields: [team_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "asset_bundles_team_fk")
  projects              projects                @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "asset_bundles_project_fk")
  asset_files           asset_files[]
  asset_pending_uploads asset_pending_uploads[]
  project_version_links project_version_links[]

  @@unique([team_id, name], map: "asset_bundles_team_name")
  @@index([owner_id], map: "asset_bundles_owner")
  @@index([project_id], map: "asset_bundles_project")
}

model asset_files {
  id            String        @id @db.VarChar(64)
  bundle_id     String        @db.VarChar(64)
  version       String        @db.VarChar(64)
  path          String        @db.VarChar(255)
  object_key    String        @db.VarChar(1024)
  url           String        @db.VarChar(1024)
  content_type  String        @db.VarChar(128)
  size          BigInt
  hash          String?       @db.VarChar(128)
  created_at    BigInt
  asset_bundles asset_bundles @relation(fields: [bundle_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "asset_files_bundle")

  @@unique([bundle_id, version, path], map: "asset_files_path")
  @@index([bundle_id, version], map: "asset_files_version")
}

model asset_pending_uploads {
  id            String                       @id @db.VarChar(64)
  bundle_id     String                       @db.VarChar(64)
  version       String                       @db.VarChar(64)
  path          String                       @db.VarChar(255)
  content_type  String                       @db.VarChar(128)
  size          BigInt
  status        asset_pending_uploads_status @default(pending)
  object_key    String?                      @db.VarChar(1024)
  etag          String?                      @db.VarChar(128)
  file_id       String?                      @db.VarChar(64)
  created_at    BigInt
  expires_at    BigInt
  asset_bundles asset_bundles                @relation(fields: [bundle_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "asset_pending_uploads_bundle")

  @@index([bundle_id], map: "asset_pending_uploads_bundle")
  @@index([expires_at], map: "asset_pending_uploads_expires")
  @@index([status], map: "asset_pending_uploads_status")
}

model audit_log {
  id          String  @id @db.VarChar(64)
  actor_id    String? @db.VarChar(64)
  action      String  @db.VarChar(64)
  target      String? @db.VarChar(255)
  at          BigInt
  detail_json String? @db.MediumText

  /// InnoDB extends every secondary index with the primary key, so this index
  /// *is* `(at, id)` and serves the keyset page; a declared `(at, id)` was
  /// measured never to be chosen and only cost a fourth B-tree per write.
  @@index([at], map: "audit_log_at")
  @@index([action, at, id], map: "audit_log_action")
  @@index([target, at, id], map: "audit_log_target")
  @@index([actor_id, at, id], map: "audit_log_actor")
}

model catalog_apps {
  id                      String                    @id @db.VarChar(64)
  name                    String                    @db.VarChar(255)
  path                    String                    @db.VarChar(255)
  description             String?                   @db.MediumText
  owner_id                String?                   @db.VarChar(64)
  slack_hook_url          String?                   @db.VarChar(1024)
  slack_channel           String?                   @db.VarChar(255)
  message_template        String?                   @db.MediumText
  keep_recent_versions    Int                       @default(3)
  created_at              BigInt
  updated_at              BigInt
  team_id                 String                    @db.VarChar(64)
  project_id              String                    @db.VarChar(64)
  members                 members?                  @relation(fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_apps_owner")
  teams                   teams                     @relation(fields: [team_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_apps_team_fk")
  projects                projects                  @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_apps_project_fk")
  catalog_artifacts       catalog_artifacts[]
  catalog_pending_uploads catalog_pending_uploads[]

  @@unique([team_id, name], map: "catalog_apps_team_name")
  @@index([owner_id], map: "catalog_apps_owner")
  @@index([project_id], map: "catalog_apps_project")
}

model catalog_artifacts {
  id                    String                     @id @db.VarChar(64)
  app_id                String                     @db.VarChar(64)
  platform              catalog_artifacts_platform
  url                   String                     @db.VarChar(1024)
  object_key            String?                    @db.VarChar(1024)
  size                  BigInt?
  hash                  String?                    @db.VarChar(128)
  tags_json             String                     @db.MediumText
  created_at            BigInt
  catalog_apps          catalog_apps               @relation(fields: [app_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "catalog_artifacts_app")
  project_version_links project_version_links[]

  @@index([app_id, created_at], map: "catalog_artifacts_app")
}

model catalog_pending_uploads {
  id           String                           @id @db.VarChar(64)
  app_id       String                           @db.VarChar(64)
  platform     catalog_pending_uploads_platform
  tags_json    String?                          @db.MediumText
  filename     String                           @db.VarChar(255)
  status       catalog_pending_uploads_status   @default(pending)
  object_key   String?                          @db.VarChar(1024)
  etag         String?                          @db.VarChar(128)
  artifact_id  String?                          @db.VarChar(64)
  created_at   BigInt
  expires_at   BigInt
  catalog_apps catalog_apps                     @relation(fields: [app_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "catalog_pending_uploads_app")

  @@index([app_id], map: "catalog_pending_uploads_app")
  @@index([expires_at], map: "catalog_pending_uploads_expires")
  @@index([status], map: "catalog_pending_uploads_status")
}

model channels {
  id          String        @id @db.VarChar(64)
  kind        channels_kind
  owner_id    String        @db.VarChar(64)
  name        String        @db.VarChar(255)
  config_json String        @db.MediumText
  secret_json String        @db.MediumText
  created_at  BigInt
  expires_at  BigInt
  disabled_at BigInt?
  deleted_at  BigInt?
  team_id     String        @db.VarChar(64)
  project_id  String        @db.VarChar(64)
  members     members       @relation(fields: [owner_id], references: [id], onUpdate: Restrict, map: "channels_owner")
  teams       teams         @relation(fields: [team_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "channels_team_fk")
  projects    projects      @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "channels_project_fk")
  state_docs  state_docs[]

  @@unique([team_id, name], map: "channels_team_name")
  @@index([kind, owner_id], map: "channels_kind_owner")
  @@index([owner_id], map: "channels_owner")
  @@index([project_id], map: "channels_project")
}

model events {
  id              String            @id @db.VarChar(64)
  title           String            @db.VarChar(255)
  status          events_status
  body_md         String            @db.MediumText
  created_by      String            @db.VarChar(64)
  created_at      BigInt
  updated_at      BigInt
  poster_key      String?           @db.VarChar(255)
  published_at    BigInt?
  place           String            @db.VarChar(255)
  place_url       String?           @db.VarChar(1024)
  duration_hours  Int
  vote_until      BigInt
  starts_at       BigInt?
  cancelled_at    BigInt?
  cancelled_by    String?           @db.VarChar(64)
  revision        Int               @default(1)
  vote_closed_at  BigInt?
  vote_closed_by  String?           @db.VarChar(64)
  vote_closed_reason String?        @db.VarChar(500)
  members         members           @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "events_creator")
  event_options   event_options[]
  event_votes     event_votes[]
  event_revisions event_revisions[]
  event_posters   event_posters[]
  event_comments  event_comments[]
  shows           shows?

  @@index([created_by], map: "events_creator")
  @@index([status, created_at], map: "events_status")
}

model event_options {
  id          String        @id @db.VarChar(64)
  event_id    String        @db.VarChar(64)
  starts_at   BigInt
  events      events        @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_options_event_fk")
  event_votes event_votes[]

  @@index([event_id, starts_at], map: "event_options_event")
}

model event_votes {
  event_id      String        @db.VarChar(64)
  member_id     String        @db.VarChar(64)
  option_id     String        @db.VarChar(64)
  updated_at    BigInt
  events        events        @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_votes_event_fk")
  members       members       @relation(fields: [member_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "event_votes_member_fk")
  event_options event_options @relation(fields: [option_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_votes_option_fk")

  @@id([event_id, member_id, option_id])
  @@index([member_id], map: "event_votes_member")
  @@index([option_id], map: "event_votes_option")
}

model event_revisions {
  event_id       String  @db.VarChar(64)
  revision       Int
  title          String  @db.VarChar(255)
  body_md        String  @db.MediumText
  poster_key     String? @db.VarChar(255)
  place          String  @db.VarChar(255)
  place_url      String? @db.VarChar(1024)
  duration_hours Int
  edited_by      String  @db.VarChar(64)
  edited_at      BigInt
  events         events  @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_revisions_event_fk")
  members        members @relation(fields: [edited_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "event_revisions_editor_fk")

  @@id([event_id, revision])
  @@index([edited_by], map: "event_revisions_editor")
}

model event_posters {
  id           String  @id @db.VarChar(64)
  event_id     String  @db.VarChar(64)
  object_key   String  @db.VarChar(255)
  content_type String  @db.VarChar(64)
  size         Int
  uploaded_by  String  @db.VarChar(64)
  uploaded_at  BigInt
  replaced_at  BigInt?
  deleted_at   BigInt?
  events       events  @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_posters_event_fk")
  members      members @relation(fields: [uploaded_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "event_posters_uploader_fk")

  @@index([event_id, uploaded_at], map: "event_posters_event")
  @@index([uploaded_by], map: "event_posters_uploader")
}

model event_comments {
  id         String  @id @db.VarChar(64)
  event_id   String  @db.VarChar(64)
  body_md    String  @db.MediumText
  created_by String  @db.VarChar(64)
  created_at BigInt
  updated_at BigInt
  events     events  @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_comments_event_fk")
  members    members @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "event_comments_author_fk")

  @@index([event_id, created_at], map: "event_comments_event")
  @@index([created_by], map: "event_comments_author")
}

model members {
  id                   String                @id @db.VarChar(64)
  github_id            BigInt                @unique(map: "members_github_id")
  github_login         String                @db.VarChar(255)
  role                 members_role
  created_at           BigInt
  approved_at          BigInt?
  approved_by          String?               @db.VarChar(64)
  api_tokens           api_tokens[]
  asset_bundles        asset_bundles[]
  sites                sites[]
  site_deploys         site_deploys[]
  catalog_apps         catalog_apps[]
  channels             channels[]
  events               events[]
  event_votes          event_votes[]
  event_revisions      event_revisions[]
  event_posters        event_posters[]
  event_comments       event_comments[]
  teams_created        teams[]               @relation("team_creator")
  team_members         team_members[]        @relation("team_member")
  team_members_decided team_members[]        @relation("team_decider")
  team_history_acted   team_history[]        @relation("history_actor")
  team_history_subject team_history[]        @relation("history_subject")
  discussions          discussions[]
  discussion_comments  discussion_comments[]
  projects             projects[]
  project_versions     project_versions[]
  issues               issues[]
  issue_comments       issue_comments[]
  platform_settings    platform_settings[]
  shows_created        shows[]               @relation("show_creator")
  shows_closed         shows[]               @relation("show_closer")
  show_grants_held     show_grants[]         @relation("show_grant_member")
  show_grants_given    show_grants[]         @relation("show_grant_granter")
  show_entries         show_entries[]
  show_entry_shots     show_entry_shots[]
  show_entry_likes     show_entry_likes[]
  show_comments        show_comments[]
  kv_collections       kv_collections[]
}

model schema_migrations {
  version    Int    @id
  applied_at BigInt
}

model state_docs {
  channel_id String   @db.VarChar(64)
  owner_id   String   @db.VarChar(64)
  version    BigInt
  body       String   @db.MediumText
  created_at BigInt
  updated_at BigInt
  channels   channels @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "state_docs_channel")

  @@id([channel_id, owner_id])
}

enum channels_kind {
  auth
  topic
  match
  lobby
  q
}

enum catalog_artifacts_platform {
  android
  ios
  bin
  server
  win32
  osx
  linux
}

enum catalog_pending_uploads_platform {
  android
  ios
  bin
  server
  win32
  osx
  linux
}

enum events_status {
  draft
  voting
  waiting
  opened
  closed
  cancelled
}

enum members_role {
  admin
  member
  pending
}

enum asset_pending_uploads_status {
  pending
  completed
  failed
}

enum catalog_pending_uploads_status {
  pending
  completed
  failed
}

model teams {
  id             String           @id @db.VarChar(64)
  name           String           @unique(map: "teams_name") @db.VarChar(255)
  description    String?          @db.MediumText
  admin_locked   Boolean          @default(false)
  created_by     String           @db.VarChar(64)
  created_at     BigInt
  updated_at     BigInt
  members        members          @relation("team_creator", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "teams_creator")
  team_members   team_members[]
  team_history   team_history[]
  discussions    discussions[]
  projects       projects[]
  channels       channels[]
  catalog_apps   catalog_apps[]
  asset_bundles  asset_bundles[]
  sites          sites[]
  kv_collections kv_collections[]

  @@index([created_by], map: "teams_creator")
}

model team_members {
  team_id      String             @db.VarChar(64)
  member_id    String             @db.VarChar(64)
  role         team_members_role
  state        team_members_state @default(active)
  requested_at BigInt
  decided_at   BigInt?
  decided_by   String?            @db.VarChar(64)
  teams        teams              @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "team_members_team")
  members      members            @relation("team_member", fields: [member_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "team_members_member_fk")
  decider      members?           @relation("team_decider", fields: [decided_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "team_members_decider_fk")

  @@id([team_id, member_id])
  @@index([member_id], map: "team_members_member")
  @@index([decided_by], map: "team_members_decider")
}

model team_history {
  id                String   @id @db.VarChar(64)
  team_id           String   @db.VarChar(64)
  at                BigInt
  actor_id          String?  @db.VarChar(64)
  action            String   @db.VarChar(64)
  subject_member_id String?  @db.VarChar(64)
  target            String?  @db.VarChar(255)
  detail_json       String?  @db.MediumText
  teams             teams    @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "team_history_team")
  actor             members? @relation("history_actor", fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "team_history_actor_fk")
  subject           members? @relation("history_subject", fields: [subject_member_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "team_history_subject_fk")

  @@index([team_id, at, id], map: "team_history_team_at")
  @@index([actor_id], map: "team_history_actor")
  @@index([subject_member_id], map: "team_history_subject")
}

model discussions {
  id                  String                @id @db.VarChar(64)
  team_id             String                @db.VarChar(64)
  title               String                @db.VarChar(255)
  body_md             String                @db.MediumText
  created_by          String                @db.VarChar(64)
  created_at          BigInt
  updated_at          BigInt
  teams               teams                 @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "discussions_team_fk")
  members             members               @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "discussions_author_fk")
  discussion_comments discussion_comments[]

  @@index([team_id, created_at], map: "discussions_team")
  @@index([created_by], map: "discussions_author")
}

model discussion_comments {
  id            String      @id @db.VarChar(64)
  discussion_id String      @db.VarChar(64)
  body_md       String      @db.MediumText
  created_by    String      @db.VarChar(64)
  created_at    BigInt
  updated_at    BigInt
  discussions   discussions @relation(fields: [discussion_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "discussion_comments_discussion_fk")
  members       members     @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "discussion_comments_author_fk")

  @@index([discussion_id, created_at], map: "discussion_comments_discussion")
  @@index([created_by], map: "discussion_comments_author")
}

model projects {
  id                String             @id @db.VarChar(64)
  team_id           String             @db.VarChar(64)
  name              String             @db.VarChar(255)
  description       String?            @db.MediumText
  next_issue_number Int                @default(1)
  created_by        String             @db.VarChar(64)
  created_at        BigInt
  updated_at        BigInt
  teams             teams              @relation(fields: [team_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "projects_team")
  members           members            @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "projects_creator_fk")
  project_versions  project_versions[]
  issues            issues[]
  channels          channels[]
  catalog_apps      catalog_apps[]
  asset_bundles     asset_bundles[]
  sites             sites[]
  kv_collections    kv_collections[]

  @@unique([team_id, name], map: "projects_team_name")
  @@index([created_by], map: "projects_creator")
}

model project_versions {
  id                    String                  @id @db.VarChar(64)
  project_id            String                  @db.VarChar(64)
  name                  String                  @db.VarChar(64)
  note                  String?                 @db.MediumText
  created_by            String                  @db.VarChar(64)
  created_at            BigInt
  projects              projects                @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "project_versions_project")
  members               members                 @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_versions_creator_fk")
  project_version_links project_version_links[]
  issues                issues[]

  @@unique([project_id, name], map: "project_versions_name")
  @@index([created_by], map: "project_versions_creator")
}

model project_version_links {
  id                String                     @id @db.VarChar(64)
  version_id        String                     @db.VarChar(64)
  kind              project_version_links_kind
  target            String                     @db.VarChar(255)
  artifact_id       String?                    @db.VarChar(64)
  bundle_id         String?                    @db.VarChar(64)
  asset_version     String?                    @db.VarChar(64)
  created_at        BigInt
  project_versions  project_versions           @relation(fields: [version_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "project_version_links_version")
  catalog_artifacts catalog_artifacts?         @relation(fields: [artifact_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "project_version_links_artifact_fk")
  asset_bundles     asset_bundles?             @relation(fields: [bundle_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "project_version_links_bundle_fk")

  @@unique([version_id, target], map: "project_version_links_target")
  @@index([artifact_id], map: "project_version_links_artifact")
  @@index([bundle_id], map: "project_version_links_bundle")
}

model issues {
  id               String            @id @db.VarChar(64)
  project_id       String            @db.VarChar(64)
  number           Int
  title            String            @db.VarChar(255)
  body_md          String            @db.MediumText
  status           issues_status     @default(open)
  version_id       String?           @db.VarChar(64)
  created_by       String            @db.VarChar(64)
  created_at       BigInt
  updated_at       BigInt
  closed_at        BigInt?
  projects         projects          @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "issues_project")
  project_versions project_versions? @relation(fields: [version_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "issues_version_fk")
  members          members           @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "issues_author_fk")
  issue_comments   issue_comments[]

  @@unique([project_id, number], map: "issues_number")
  @@index([project_id, status, number], map: "issues_status")
  @@index([version_id], map: "issues_version")
  @@index([created_by], map: "issues_author")
}

model issue_comments {
  id         String  @id @db.VarChar(64)
  issue_id   String  @db.VarChar(64)
  body_md    String  @db.MediumText
  created_by String  @db.VarChar(64)
  created_at BigInt
  updated_at BigInt
  issues     issues  @relation(fields: [issue_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "issue_comments_issue_fk")
  members    members @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "issue_comments_author_fk")

  @@index([issue_id, created_at], map: "issue_comments_issue")
  @@index([created_by], map: "issue_comments_author")
}

model platform_settings {
  key        String   @id @db.VarChar(64)
  value_json String   @db.MediumText
  updated_by String?  @db.VarChar(64)
  updated_at BigInt
  members    members? @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "platform_settings_updater_fk")

  @@index([updated_by], map: "platform_settings_updater")
}

enum team_members_role {
  owner
  member
  pending
}

enum team_members_state {
  active
  declined
  kicked
}

enum project_version_links_kind {
  artifact
  asset_version
}

enum issues_status {
  open
  closed
}

/// Static sites on the shared `g.yyt.life` host (docs/decisions.md *Static sites*).
model sites {
  id                String         @id @db.VarChar(64)
  team_id           String         @db.VarChar(64)
  project_id        String         @db.VarChar(64)
  name              String         @db.VarChar(255)
  /// URL path segment; opaque, random, never reused. Binary: it is an S3 key prefix.
  slug              String         @unique(map: "sites_slug") @db.VarChar(16)
  description       String?        @db.MediumText
  owner_id          String?        @db.VarChar(64)
  current_deploy_id String?        @db.VarChar(64)
  /// Claim held by the deploy (or the delete) in flight; null when idle.
  active_deploy_id  String?        @db.VarChar(64)
  created_at        BigInt
  updated_at        BigInt
  members           members?       @relation(fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sites_owner")
  teams             teams          @relation(fields: [team_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sites_team_fk")
  projects          projects       @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sites_project_fk")
  site_deploys      site_deploys[]

  @@unique([team_id, name], map: "sites_team_name")
  @@index([owner_id], map: "sites_owner")
  @@index([project_id], map: "sites_project")
}

/// One zip upload per row; the row is created with the presign and ends `live` or `failed`.
model site_deploys {
  id         String              @id @db.VarChar(64)
  site_id    String              @db.VarChar(64)
  status     site_deploys_status @default(pending)
  zip_bytes  BigInt
  bytes      BigInt              @default(0)
  files      Int                 @default(0)
  error      String?             @db.VarChar(255)
  object_key String              @db.VarChar(1024)
  created_by String?             @db.VarChar(64)
  created_at BigInt
  updated_at BigInt
  expires_at BigInt
  sites      sites               @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "site_deploys_site")
  members    members?            @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "site_deploys_creator")

  @@index([site_id, created_at], map: "site_deploys_site")
  @@index([status, updated_at], map: "site_deploys_status")
  @@index([created_by], map: "site_deploys_creator")
}

enum site_deploys_status {
  pending
  queued
  extracting
  live
  failed
}

/// A gallery of what members built (docs/decisions.md *Show (console)*).
/// Platform-global like an event: it belongs to no team and no project, and
/// carries its own tiny grant table instead of going through `teamAccess`.
model shows {
  id         String         @id @db.VarChar(64)
  title      String         @db.VarChar(255)
  body_md    String         @db.MediumText
  acl        shows_acl
  /// The event this show was spawned from, if any. Nullable **and** unique on
  /// purpose: MySQL treats NULLs as distinct, so this allows unlimited
  /// event-less shows while pinning at most one show per event. Deleting the
  /// event clears the link and leaves the gallery standing (decision 11).
  event_id   String?        @unique(map: "shows_event") @db.VarChar(64)
  created_by String         @db.VarChar(64)
  created_at BigInt
  updated_at BigInt
  /// Closed means read-only; it is reversible and says nothing about who may read.
  closed_at  BigInt?
  closed_by  String?        @db.VarChar(64)
  events     events?        @relation(fields: [event_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "shows_event_fk")
  creator    members        @relation("show_creator", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "shows_creator_fk")
  closer     members?       @relation("show_closer", fields: [closed_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "shows_closer_fk")
  grants     show_grants[]
  entries    show_entries[]

  @@index([created_at, id], map: "shows_created")
  /// Serves both the "5 open shows per member" cap and `?state=open|closed`.
  @@index([created_by, closed_at], map: "shows_creator")
  /// Declared rather than left to the FK: an index MariaDB auto-creates would
  /// be the only one in the database that `schema.prisma` does not name.
  @@index([closed_by], map: "shows_closer")
}

/// A row *is* write permission: `public`/`member_only` already decide who reads,
/// so a read grant would express nothing (decision 3).
model show_grants {
  show_id    String  @db.VarChar(64)
  member_id  String  @db.VarChar(64)
  granted_by String  @db.VarChar(64)
  granted_at BigInt
  shows      shows   @relation(fields: [show_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "show_grants_show_fk")
  member     members @relation("show_grant_member", fields: [member_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "show_grants_member_fk")
  granter    members @relation("show_grant_granter", fields: [granted_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "show_grants_granter_fk")

  @@id([show_id, member_id])
  @@index([member_id], map: "show_grants_member")
  @@index([granted_by], map: "show_grants_granter")
}

/// One submitted deliverable. There is deliberately **no** foreign key to the
/// target: a team stays free to delete its own app/bundle/site and the entry
/// survives on `target_name` (decision 6).
model show_entries {
  id          String              @id @db.VarChar(64)
  show_id     String              @db.VarChar(64)
  target_kind show_entries_target
  target_id   String              @db.VarChar(64)
  /// Display name snapshotted at submit time; the target may be gone.
  target_name String              @db.VarChar(255)
  /// The exhibited artifact (app) or version (bundle), pinned at submit time
  /// so a later build is not published by an entry nobody touched. A site
  /// links live and stores NULL (decision 5).
  target_ref  String?             @db.VarChar(255)
  title       String              @db.VarChar(255)
  body_md     String              @db.MediumText
  created_by  String              @db.VarChar(64)
  created_at  BigInt
  updated_at  BigInt
  shows       shows               @relation(fields: [show_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "show_entries_show_fk")
  members     members             @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "show_entries_author_fk")
  shots       show_entry_shots[]
  likes       show_entry_likes[]
  comments    show_comments[]

  @@unique([show_id, target_kind, target_id], map: "show_entries_target")
  @@index([show_id, created_at, id], map: "show_entries_show")
  @@index([target_kind, target_id], map: "show_entries_target_lookup")
  @@index([created_by], map: "show_entries_author")
}

/// Screenshot upload log. A `pending` row is the presign reservation and counts
/// against the 3-per-entry cap until it expires (`rules/data.md`: a grant is a
/// reservation). `replaced_at` set with `deleted_at` NULL = the S3 delete failed
/// and the daily sweep retries it.
model show_entry_shots {
  id           String                  @id @db.VarChar(64)
  entry_id     String                  @db.VarChar(64)
  status       show_entry_shots_status @default(pending)
  ord          Int                     @default(0)
  /// The S3 key *and* what `commit` compares a caller-supplied string against,
  /// so it is binary: under `_ci` a case-shifted key would match another
  /// object's row. Same reason as `4_assets_binary_paths`.
  object_key   String                  @unique(map: "show_entry_shots_key") @db.VarChar(255)
  content_type String                  @db.VarChar(64)
  size         Int
  uploaded_by  String                  @db.VarChar(64)
  uploaded_at  BigInt
  expires_at   BigInt
  replaced_at  BigInt?
  deleted_at   BigInt?
  entries      show_entries            @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "show_entry_shots_entry_fk")
  members      members                 @relation(fields: [uploaded_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "show_entry_shots_uploader_fk")

  @@index([entry_id, status, ord], map: "show_entry_shots_entry")
  @@index([status, expires_at], map: "show_entry_shots_status")
  /// The sweep's delete queue (`status = replaced`) and its purge, both keyed
  /// on the selective column. `(replaced_at, deleted_at)` was measured never to
  /// be chosen: `replaced_at IS NOT NULL` is not selective enough to beat a scan.
  @@index([status, deleted_at], map: "show_entry_shots_delete_queue")
  @@index([uploaded_by], map: "show_entry_shots_uploader")
}

/// A like is set membership; counts are derived, never stored (decision 10).
model show_entry_likes {
  entry_id  String       @db.VarChar(64)
  member_id String       @db.VarChar(64)
  liked_at  BigInt
  entries   show_entries @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "show_entry_likes_entry_fk")
  members   members      @relation(fields: [member_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "show_entry_likes_member_fk")

  @@id([entry_id, member_id])
  @@index([member_id], map: "show_entry_likes_member")
}

model show_comments {
  id         String       @id @db.VarChar(64)
  entry_id   String       @db.VarChar(64)
  body_md    String       @db.MediumText
  created_by String       @db.VarChar(64)
  created_at BigInt
  updated_at BigInt
  entries    show_entries @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "show_comments_entry_fk")
  members    members      @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "show_comments_author_fk")

  @@index([entry_id, created_at, id], map: "show_comments_entry")
  @@index([created_by], map: "show_comments_author")
}

enum shows_acl {
  public
  member_only
}

enum show_entries_target {
  app
  bundle
  site
}

enum show_entry_shots_status {
  pending
  live
  replaced
}

/// A collection of JSON values addressed by key, under a project
/// (docs/decisions.md *Key-value store (`kv`)*). Served to games by the state
/// stack under `/kv/*`; console owns the schema and every migration.
///
/// `read_scope`, `write_scope` and `encrypted` never change after creation: the
/// state stack writes while console edits, and a shape change mid-flight would
/// mix plaintext with ciphertext, or shared rows with owner rows, in one table.
model kv_collections {
  id                    String       @id @db.VarChar(64)
  team_id               String       @db.VarChar(64)
  project_id            String       @db.VarChar(64)
  name                  String       @db.VarChar(255)
  description           String?      @db.MediumText
  read_scope            kv_scope
  write_scope           kv_scope
  encrypted             Boolean      @default(false)
  max_entries           Int          @default(10000)
  max_entries_per_owner Int          @default(100)
  /// Creator, kept for display; authorization is team membership.
  owner_id              String?      @db.VarChar(64)
  /// Soft-delete claim. The name is freed at once (set to the id) and the rows
  /// drain in bounded batches, inline first and by the sweep afterwards.
  deleted_at            BigInt?
  created_at            BigInt
  updated_at            BigInt
  members               members?     @relation(fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "kv_collections_owner")
  teams                 teams        @relation(fields: [team_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "kv_collections_team_fk")
  projects              projects     @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "kv_collections_project_fk")
  kv_entries            kv_entries[]
  kv_keys               kv_keys?

  @@unique([team_id, name], map: "kv_collections_team_name")
  @@index([owner_id], map: "kv_collections_owner")
  @@index([project_id], map: "kv_collections_project")
}

/// One value per `(collection, owner, key)`. `owner_id` is `""` in a shared
/// namespace and the entry's owner in a user namespace; both `owner_id` and `k`
/// are `utf8mb4_bin` in the migration (identities and keys are compared
/// byte-exactly), which this schema file cannot express.
model kv_entries {
  collection_id  String         @db.VarChar(64)
  owner_id       String         @db.VarChar(64)
  k              String         @db.VarChar(128)
  /// JSON text exactly as sent, or `enc1.{iv}.{ct}.{tag}` when the collection
  /// is encrypted. The platform never parses it.
  v              String         @db.MediumText
  /// Plaintext byte length, so an encrypted collection still reports real sizes.
  bytes          Int
  /// Monotonic per key. An expiry never resets it, or a stale `If-Match` could
  /// land on the reborn key.
  version        BigInt
  /// The auth channel whose credential wrote this row; NULL for console writes.
  /// Deliberately no foreign key -- channel rows are purged 30 days after their
  /// soft-delete, and the entry purge must stay explicit console work.
  channel_id     String?        @db.VarChar(64)
  expires_at     BigInt?
  created_at     BigInt
  updated_at     BigInt
  kv_collections kv_collections @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "kv_entries_collection")

  @@id([collection_id, owner_id, k])
  /// Expiry purge, always per collection: a global `WHERE expires_at <= now`
  /// cannot use this index (`rules/data.md`, leading-column rule).
  @@index([collection_id, expires_at], map: "kv_entries_expiry")
  @@index([channel_id], map: "kv_entries_channel")
}

/// The wrapped data key of an encrypted collection. State-stack only: console
/// holds no KEK, never selects this table, and therefore cannot read a value.
model kv_keys {
  collection_id  String         @id @db.VarChar(64)
  /// `v1.{iv}.{ct}.{tag}`, base64url, AES-256-GCM(KEK) with the collection id
  /// as associated data.
  dek_wrapped    String         @db.VarChar(255)
  created_at     BigInt
  kv_collections kv_collections @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "kv_keys_collection")
}

// One enum shared by `kv_collections.read_scope` and `.write_scope`. MySQL
// orders an ENUM by declaration, so values are appended only; removing one is a
// `-- contract` migration. Keep it multi-line -- `test/enumOrder.test.ts` parses
// the body line by line, and a comment inside the block would read as a value.
enum kv_scope {
  team
  project
  user
}
