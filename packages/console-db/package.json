{
  "name": "@yyt/console-db",
  "version": "0.0.0",
  "private": true,
  "description": "Console MySQL schema (migrations) and repositories shared by console (writer) and auth/topic/match (SELECT-only readers)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.2.0",
    "@prisma/client": "7.2.0",
    "@yyt/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.2.0",
    "testcontainers": "^12.1.0"
  }
}
