{
  "name": "@yyt/redis",
  "version": "0.0.0",
  "private": true,
  "description": "Kv interface over self-hosted Redis (ioredis, TCP), in-memory fake, distributed lock",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yyt/core": "workspace:*",
    "ioredis": "^6.0.0"
  }
}
