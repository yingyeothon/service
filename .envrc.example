# Copy to .envrc (git-ignored) or fetch with scripts/get-envrc.sh. Stored in SSM via scripts/put-envrc.sh.
export AWS_PROFILE=yyt
export AWS_REGION=ap-northeast-2
# Upstash Redis (REST). Runtime secrets for Lambda come from SSM /yyt-service/{stage}/*, not from here.
export UPSTASH_REDIS_REST_URL=
export UPSTASH_REDIS_REST_TOKEN=
# Optional: run the Kv contract tests against a real instance.
# export UPSTASH_TEST_URL=$UPSTASH_REDIS_REST_URL
# export UPSTASH_TEST_TOKEN=$UPSTASH_REDIS_REST_TOKEN
