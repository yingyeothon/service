#!/usr/bin/env bash
# Defense in depth for a PUBLIC repo (rules/security.md):
#  1. refuse .env*/.envrc files and anything under local/ (except README/env.example), even when force-added;
#  2. refuse lines that look like our stateful host / service account identifiers;
#  3. gitleaks on the staged diff.
# Every check captures its matches instead of using `grep -q`: `grep -q` exits at the first hit, which
# SIGPIPEs the upstream grep, and under `pipefail` that 141 made the whole test false — the guard passed
# silently on exactly the large diffs it exists to catch.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACMR)
bad=$(echo "$staged" | grep -E '(^|/)\.env(\.|$)|(^|/)\.envrc$|^local/' | grep -vE '\.example$|^local/README\.md$' || true)
if [ -n "$bad" ]; then echo "pre-commit: refusing secret-bearing paths:" >&2; echo "$bad" >&2; exit 1; fi
# Identifier patterns (host, address, DB, account names) live in gitignored local/identifiers.txt — one ERE
# per line, generated by scripts/local-identifiers.sh — so the patterns themselves never reach the public repo.
if [ ! -s local/identifiers.txt ]; then
  echo "pre-commit: local/identifiers.txt is missing or empty — run scripts/local-identifiers.sh" >&2
  echo "pre-commit: set YYT_ALLOW_NO_IDENTIFIERS=1 only if you know the guard is unnecessary here" >&2
  [ "${YYT_ALLOW_NO_IDENTIFIERS:-}" = "1" ] || exit 1
fi
if [ -n "$staged" ] && [ -s local/identifiers.txt ]; then
  hits=$(git diff --cached -U0 -- $staged | grep -E '^\+' | grep -vE '^\+\+\+' | grep -cE -f local/identifiers.txt || true)
  if [ "${hits:-0}" -gt 0 ]; then
    echo "pre-commit: $hits added line(s) carry stateful host / DB / account identifiers; refer to the private yyt-stateful repo instead" >&2
    echo "pre-commit: list them with: git diff --cached -U0 | grep -E '^\\+' | grep -E -f local/identifiers.txt" >&2
    exit 1
  fi
fi
command -v gitleaks >/dev/null || { echo "pre-commit: gitleaks is required (apt install gitleaks / brew install gitleaks)" >&2; exit 1; }
gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
