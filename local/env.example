# Layout of local/env/<service>.<stage>.env (real files are gitignored; see local/README.md).
STAGE=dev
MYSQL_HOST=<stateful-host>
MYSQL_PORT=3306
MYSQL_DATABASE=<database>
MYSQL_USER=<service-user>
MYSQL_PASSWORD=
REDIS_HOST=<stateful-host>
REDIS_PORT=6379
REDIS_USER=<service-user>
REDIS_PASSWORD=
REDIS_KEY_PREFIX=<service>:dev:
# console only, optional (todo/16 B): the Redis account that mints per-channel participant
# credentials. It can create and delete Redis users, so it is a second account rather than
# extra rights on REDIS_USER above; absent = /channels/{id}/redis-user answers 503.
# Set BOTH or NEITHER; bootstrap-ssm.sh refuses a half-set pair. Leave the
# placeholder in place only if you are not configuring an issuer on this stage.
REDIS_ACL_USER=
REDIS_ACL_PASSWORD=
# state only: this file has no REDIS_* block at all. The state service holds no Redis
# connection (a channel row carries secrets and rules/data.md forbids caching one), and its
# MySQL account is table-scoped — SELECT on `channels` and `kv_collections` plus writes on
# `state_docs`, `kv_entries` and `kv_keys`, nothing else. A stage with no state.<stage>.env
# simply has no state stack; bootstrap-ssm.sh skips it and console then omits `docUrl` from
# auth channel views.
# state only (todo/33): the stage KEK that wraps every kv collection's data key, 32 bytes of
# hex (`openssl rand -hex 32`). bootstrap-ssm.sh keeps whatever SSM already holds and
# generates one when nothing does, so leave this empty unless you are seeding a stage by hand;
# replacing an existing KEK needs KV_KEK_ROTATE=1 and makes every stored kv value unreadable.
# Absent, the stage deploys and answers 503 on `/kv/*` alone. scripts/get-env.sh restores it.
KV_KEK=
# console only (operator GitHub OAuth app + bootstrap admins; see docs/decisions.md). Shell env vars override.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGINS=<comma-separated github logins>
# Not part of these files: the realtime gateway's stage-wide SSM keys. `gateway-token` is
# generated by scripts/bootstrap-ssm.sh (copy: local/deploy/gateway-token.<stage>) and
# `gateway-ws-url` is set by hand. scripts/get-env.sh restores neither.
