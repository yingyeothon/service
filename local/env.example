# Layout of local/env/<service>.<stage>.env (real files are gitignored; see local/README.md).
STAGE=dev
MYSQL_HOST=<stateful-host>
MYSQL_PORT=3306
MYSQL_DATABASE=<database>
MYSQL_USER=<service-user>
MYSQL_PASSWORD=
REDIS_HOST=<stateful-host>
REDIS_PORT=6379
REDIS_USER=<service-user>
REDIS_PASSWORD=
REDIS_KEY_PREFIX=<service>:dev:
# console only (operator GitHub OAuth app + bootstrap admins; see docs/decisions.md). Shell env vars override.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGINS=<comma-separated github logins>
# Not part of these files: the realtime gateway's stage-wide SSM keys. `gateway-token` is
# generated by scripts/bootstrap-ssm.sh (copy: local/deploy/gateway-token.<stage>) and
# `gateway-ws-url` is set by hand. scripts/get-env.sh restores neither.
