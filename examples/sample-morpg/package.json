{
  "name": "yyt-sample-morpg",
  "version": "0.0.0",
  "private": true,
  "description": "Sample MORPG stack on tslib: lobby on the yyt realtime gateway, instanced dungeon actor, character sheets in the doc store",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p web",
    "test": "vitest run",
    "lint": "eslint .",
    "play": "node scripts/play.mjs",
    "pack-assets": "node scripts/pack-assets.mjs",
    "web": "vite web",
    "web:build": "vite build web",
    "web:config": "node scripts/web-config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.864.0",
    "@yingyeothon/gamebase-all-together": "^2.0.0",
    "@yingyeothon/lambda-gamebase": "^2.0.0",
    "@yingyeothon/logger": "^2.0.0",
    "@yingyeothon/naive-redis": "^2.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.864.0",
    "@eslint/js": "^9.34.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@yingyeothon/gamebase-client": "^2.0.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "globals": "^17.11.0",
    "serverless-esbuild": "^1.55.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
