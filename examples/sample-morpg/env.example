# examples/sample-morpg deploy env (copy to local/deploy/morpg.<stage>.env in the service repo; gitignored).
# scripts/smoke/morpg.mjs setup writes every line below.
# From the auth channel (console → channels → auth):
JWT_SECRET_KEY=
JWT_ISSUER=yyt-auth/<authChannelId>
JWT_AUDIENCE=<auth channel audience>
# The `q` channel's participant Redis credential (console → q channel → Redis credential).
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=game:<stage>:<qChannelId>:
# The `q` channel's wsUrl (wss://gw.yyt.life/?channel=<qChannelId>); the roster
# route of the same host serves the lobby's parties.
GATEWAY_WS_URL=
# The lobby channel whose parties enter dungeons.
LOBBY_CHANNEL_ID=
# Doc store of the auth channel (console → auth channel → Document storage): the
# `docUrl` the console shows for that channel (per stage) + the apiKey.
DOC_BASE_URL=
DOC_API_KEY=
# The map bundle (self-contained JSON, README §4.6), the same URL the lobby channel's mapUrl carries.
MAP_URL=
# Optional: running-stage length in seconds (default 600; the smoke uses a short one).
GAME_RUNNING_SECONDS=
# Set by serverless.yml on deploy; only scripts/local-api.mjs needs them from the shell:
# CALLBACK_BASE_URL=<the deployed ApiUrl>   GAME_ACTOR_LAMBDA_NAME=yyt-sample-morpg-<stage>-actor
