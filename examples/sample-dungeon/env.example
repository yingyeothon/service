# examples/sample-dungeon deploy env (copy to local/env/game.<stage>.env in the service repo; gitignored).
# From the auth channel (console → channels → auth):
JWT_SECRET_KEY=
JWT_ISSUER=yyt-auth/<authChannelId>
JWT_AUDIENCE=<auth channel audience>
# From the match channel (console → channels → match): its apiKey.
MATCH_API_KEY=
# Redis the game owns (key pattern must match REDIS_KEY_PREFIX).
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
# `<name>:<stage>:` (lowercase letters, digits, `-`), or `game:<stage>:<channelId>:`
# when REDIS_* is a console `q` channel's participant credential.
REDIS_KEY_PREFIX=game:dev:
# Optional — gateway mode: the `wsUrl` shown on a console `q` channel
# (`wss://gw.yyt.life/?channel=<id>`); REDIS_* must then be that channel's
# participant credential (console → channel → Redis credential).
GATEWAY_WS_URL=
# Optional — server-less rooms: a topic channel on the same auth channel.
TOPIC_BASE_URL=https://topic.yyt.life
TOPIC_API_KEY=
# Only when a *different* match channel targets /match-callback-topic (defaults to MATCH_API_KEY).
MATCH_API_KEY_TOPIC=
