{
  "name": "@yyt/service-console",
  "version": "0.0.0",
  "private": true,
  "description": "console.yyt.life — operator console API: GitHub login, members, API tokens, channel CRUD, expiry cron",
  "type": "module",
  "scripts": {
    "build": "echo 'bundled by serverless-esbuild at deploy time'",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "serverless deploy --stage dev --region ap-northeast-2"
  },
  "dependencies": {
    "@yyt/console-db": "workspace:*",
    "@yyt/core": "workspace:*",
    "@yyt/http": "workspace:*",
    "@yyt/redis": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "serverless-domain-manager": "^8.0.0",
    "serverless-esbuild": "^1.55.0"
  }
}
