# Copy of the layout of services/<svc>/.env.<stage> (real files are gitignored; values come from yyt-stateful bootstrap, 2026-08-22).
STAGE=dev
MYSQL_HOST=<stateful-host>
MYSQL_PORT=3306
MYSQL_DATABASE=<database>
MYSQL_USER=<service-user>
MYSQL_PASSWORD=
REDIS_HOST=<stateful-host>
REDIS_PORT=6379
REDIS_USER=<service-user>
REDIS_PASSWORD=
REDIS_KEY_PREFIX=<service>:dev:
