{
  "name": "@yyt/service-auth",
  "version": "0.0.0",
  "private": true,
  "description": "auth.yyt.life \u2014 per-channel OAuth login (GitHub/Google) issuing HS256 channel JWTs",
  "type": "module",
  "scripts": {
    "build": "echo 'bundled by serverless-esbuild at deploy time'",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "serverless deploy --stage dev --region ap-northeast-2"
  },
  "dependencies": {
    "@yyt/console-db": "workspace:*",
    "@yyt/core": "workspace:*",
    "@yyt/http": "workspace:*",
    "@yyt/jwt": "workspace:*",
    "@yyt/redis": "workspace:*",
    "jose": "^6.0.12",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "serverless-domain-manager": "^8.0.0",
    "serverless-esbuild": "^1.55.0"
  }
}
