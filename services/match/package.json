{
  "name": "@yyt/service-match",
  "version": "0.0.0",
  "private": true,
  "description": "match.yyt.life — FIFO party matchmaker over API Gateway WebSocket with signed callbacks",
  "type": "module",
  "scripts": {
    "build": "echo 'bundled by serverless-esbuild at deploy time'",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "serverless deploy --stage dev --region ap-northeast-2"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.864.0",
    "@yyt/console-db": "workspace:*",
    "@yyt/core": "workspace:*",
    "@yyt/http": "workspace:*",
    "@yyt/jwt": "workspace:*",
    "@yyt/redis": "workspace:*",
    "@yyt/ws": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "serverless-domain-manager": "^8.0.0",
    "serverless-esbuild": "^1.55.0"
  }
}
